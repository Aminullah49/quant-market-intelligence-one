rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Recommendations Collection
    match /recommendations/{recommendationId} {
      // Anyone can read the platform recommendations and action plans
      allow read: if true;

      // Validate on creation or update to prevent injection attacks or corrupted data
      allow create, update: if isValidRecommendation(request.resource.data);

      // Deletion allowed
      allow delete: if true;
    }

    // 3. User Broker Profiles Collection (User specific broker routing and balances)
    match /user_brokers/{userId} {
      allow read: if true;
      allow create, update: if isValidUserBrokerProfile(request.resource.data);
      allow delete: if true;
    }

    // 4. User Broker Trades Collection (Orders executed to connected broker)
    match /user_trades/{tradeId} {
      allow read: if true;
      allow create, update: if isValidUserBrokerTrade(request.resource.data);
      allow delete: if true;
    }

    // 5. Validation Helper for Recommendations Entity
    function isValidRecommendation(data) {
      return data.keys().hasAll(['title', 'category', 'impact', 'effort', 'status', 'description', 'assignedTo', 'createdAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.impact in ['Low', 'Medium', 'High', 'Critical']
        && data.effort in ['Low', 'Medium', 'High']
        && data.status in ['Proposed', 'In Progress', 'Completed', 'Deferred']
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && data.assignedTo is string && data.assignedTo.size() > 0 && data.assignedTo.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // 6. Validation Helper for User Broker Profile
    function isValidUserBrokerProfile(data) {
      return data.keys().hasAll(['userId', 'primaryBrokerId', 'primaryBrokerName', 'primaryAccountNo', 'balance', 'equity', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 100
        && data.primaryBrokerId is string && data.primaryBrokerId.size() > 0 && data.primaryBrokerId.size() <= 100
        && data.primaryBrokerName is string && data.primaryBrokerName.size() > 0 && data.primaryBrokerName.size() <= 150
        && data.primaryAccountNo is string && data.primaryAccountNo.size() > 0 && data.primaryAccountNo.size() <= 100
        && data.balance is number
        && data.equity is number
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // 7. Validation Helper for User Broker Trade
    function isValidUserBrokerTrade(data) {
      return data.keys().hasAll(['ticketId', 'userId', 'brokerId', 'brokerName', 'accountNo', 'symbol', 'side', 'price', 'lotSize', 'stopLoss', 'takeProfit', 'status', 'timestamp'])
        && data.ticketId is string && data.ticketId.size() > 0 && data.ticketId.size() <= 100
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 100
        && data.brokerId is string && data.brokerId.size() > 0 && data.brokerId.size() <= 100
        && data.brokerName is string && data.brokerName.size() > 0 && data.brokerName.size() <= 150
        && data.accountNo is string && data.accountNo.size() > 0 && data.accountNo.size() <= 100
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 50
        && data.side in ['BUY', 'SELL']
        && data.price is number
        && data.lotSize is number
        && data.stopLoss is number
        && data.takeProfit is number
        && data.status in ['OPEN', 'CLOSED', 'CANCELLED']
        && data.timestamp is string && data.timestamp.size() <= 50;
    }
  }
}
